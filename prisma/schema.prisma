// CECODES Carbon Footprint Tool - domain schema
// See docs/CECODES Carbon Footprint Tool - Requirements.md and docs/CECODES - Tech Stack Decision.md
// All emission/factor numbers use Decimal (Postgres NUMERIC) - never Float/Int - to preserve exact values.
//
// RLS note: tenant tables carry a denormalized `companyId` so Row-Level Security policies can be a
// simple, index-backed `company_id = private.current_company_id()`. The app sets companyId on write.

generator client {
  provider = "prisma-client"
  output   = "../src/lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Scope {
  SCOPE_1 // Alcance 1 - direct emissions
  SCOPE_2 // Alcance 2 - purchased electricity
  SCOPE_3 // Alcance 3 - other indirect
}

enum GwpSet {
  AR5 // reporting years up to and including 2021 (boundary pending - Req. §12.5)
  AR6 // reporting years after 2021
}

// How ActivityEntry.value (plus, for COUNT_TIMES_DISTANCE, secondaryValue) is turned into the
// physical activity quantity the engine actually prices - client feedback 2026-08-15, Scope 3
// Categoria 6/7. Default QUANTITY preserves today's behavior for every existing factor.
enum EntryMode {
  QUANTITY // value IS the activity quantity, in EmissionFactor.unit - every factor before this
  MONEY_PER_GALLON // value is money (COP); divide by that year's TransportSubsidyPrice to get gallons
  COUNT_TIMES_DISTANCE // value is a passenger/vehicle count, secondaryValue is distance in km; multiply
}

// Which fuel a MONEY_PER_GALLON factor buys, so the engine divides the reported money by the
// right yearly average price - client feedback 2026-09-03 (E4): "gas and diesel prices table,
// but again I need to be able to add them from admin user". Before this, transport_subsidy_prices
// held ONE price per year and both C6 subsidy factors divided by it, so diesel was charged the
// gasoline price. Null on every factor that is not a transport subsidy.
enum FuelType {
  GASOLINE // C6: Gasolina E10 (Comercial) - Móvil
  DIESEL // C6: Diésel B10 (Mezcla comercial) - Móvil
}

enum Role {
  COMPANY_USER // Usuario Empresa - sees only their own company
  CECODES_ADMIN // Administrador CECODES - the seeded admin; manages factor library + all companies
}

// What an admin did to a factor. IMPORTED is written by prisma/import-factors.ts; its
// absence on every change row for a factor is what marks that factor "never edited by a
// human", which is the signal the importer uses to decide it may safely overwrite.
enum FactorChangeAction {
  CREATED
  UPDATED
  DEACTIVATED
  REACTIVATED
  IMPORTED
}

// ---------------------------------------------------------------------------
// Identity (Supabase Auth owns auth.users; we mirror role + company link here)
// ---------------------------------------------------------------------------

model AppUser {
  id        String   @id // = Supabase auth user id (uuid)
  email     String   @unique
  // Contact and identity for traceability. CECODES asked for these (2026-07-18) so that when a
  // company has several people using the tool and a figure is wrong, they know who to reach.
  // Nullable: they did not exist when earlier users were created, and /register only takes an
  // email and password. Position (cargo) is kept alongside the name because a role outlives the
  // person who holds it.
  name      String?
  phone     String?
  position  String?
  role      Role     @default(COMPANY_USER)
  company   Company? @relation(fields: [companyId], references: [id])
  companyId String?
  // A deactivated user keeps their auth credentials but is refused at every server entry
  // point (requireAppUser, resolveCompanyScope, resolveAdminScope, signInAction). The role
  // and this flag live in Postgres, not in the JWT, so every request re-reads them and a
  // deactivation takes effect immediately without revoking a session.
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  factorChanges EmissionFactorChange[]
  entryChanges  ActivityEntryChange[]

  @@index([companyId])
  @@map("app_users")
}

// ---------------------------------------------------------------------------
// Reporting entities: Company -> Facility -> ReportingYear -> ActivityEntry
// ---------------------------------------------------------------------------

model Company {
  id           String     @id @default(uuid())
  name         String // Empresa
  sector       String? // optional; slug from src/lib/sectors.ts, free text for legacy rows
  contactEmail String? // optional; shown on reports
  // The identifying details the report header prints - client feedback 2026-09-03 (D5), "the
  // first thing the user will visualize is their information". build-pdf.tsx has had rendering
  // branches for all six since that round; until now toCompanyProfile hardcoded them to null
  // because the columns did not exist.
  //
  // `nit` is the Colombian tax id. Deliberately NOT unique: legacy rows may repeat or omit it,
  // and a plain unique index would treat two NULLs as distinct anyway (IMPLEMENTATION.md §11).
  nit           String?
  employeeCount Int? // Colaboradores
  contactName   String?
  contactRole   String?
  contactPhone  String?
  website       String?
  // A deactivated company blocks its own users. Admins may still open it to fix and
  // reactivate it, which is why resolveCompanyScope checks this only on the company-user path.
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  facilities   Facility[]
  users        AppUser[]
  target       CompanyTarget?

  @@map("companies")
}

model Facility {
  id             String          @id @default(uuid())
  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId      String
  name           String // Planta
  location       String // Ubicación / Sede
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  reportingYears ReportingYear[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("facilities")
}

model ReportingYear {
  id         String   @id @default(uuid())
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  facilityId String
  companyId  String // denormalized for RLS
  year       Int
  gwpSet     GwpSet // resolved from `year` at creation, but stored for reproducibility
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  entries       ActivityEntry[]
  entryChanges  ActivityEntryChange[]
  results       ResultSnapshot[]
  applicability CategoryApplicability[]
  cleanTech     CleanTechEntry[]

  @@unique([facilityId, year])
  // Backs the composite foreign key from activity_entries, which makes it impossible for a
  // child row to claim one company while its reporting year belongs to another.
  @@unique([id, companyId])
  @@index([companyId])
  @@map("reporting_years")
}

// One activity-data value.
// Scope 2 (electricity) => 12 rows per source (month 1..12).
// Scopes 1 & 3          => 1 row per source (month = null, i.e. annual).
//
// Adding a source creates its rows immediately with value = null, so the rows record that
// the source applies to the year. `value = null` means "not reported yet"; `value = 0`
// means the company genuinely consumed nothing. Both contribute 0 to the total, but only
// the second is an answer.
model ActivityEntry {
  id String @id @default(uuid())

  // Composite foreign key. Binding companyId into the relation makes it impossible for an
  // entry to claim one company while its reporting year belongs to another. It references
  // ReportingYear's @@unique([id, companyId]).
  reportingYear   ReportingYear @relation(fields: [reportingYearId, companyId], references: [id, companyId], onDelete: Cascade)
  reportingYearId String
  companyId       String // denormalized for RLS

  // Link to the factor used, plus denormalized labels/units captured at entry time
  emissionFactor   EmissionFactor? @relation(fields: [emissionFactorId], references: [id])
  emissionFactorId String?

  scope       Scope
  category    String
  subcategory String?
  element     String
  unit        String // consumption unit shown to the user (gal, kWh, kg, km, ...)

  month Int? // 1..12 for Scope 2; null = annual (Scopes 1 & 3)
  value Decimal? @db.Decimal(20, 6) // activity data - decimals allowed, never truncated; null = not reported
  // Only meaningful when emissionFactor.entryMode = COUNT_TIMES_DISTANCE: distance in km, paired
  // with `value` holding the passenger/vehicle count (client feedback 2026-08-15). Null for
  // every other entry.
  secondaryValue Decimal? @db.Decimal(20, 6)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One row per route for a COUNT_TIMES_DISTANCE source (C4/C6/C7/C9). Empty for every other
  // entry, and empty for a transport source entered before trip rows existed.
  trips TransportTrip[]

  // Dedupes the 12 Scope-2 month rows. Postgres treats NULLs as distinct, so the annual
  // (month IS NULL) rows are deduped by a partial unique index in the migration instead.
  @@unique([reportingYearId, emissionFactorId, month])
  // Backs the composite foreign key from transport_trips, exactly as ReportingYear's
  // @@unique([id, companyId]) backs the one from activity_entries.
  @@unique([id, companyId])
  @@index([reportingYearId, scope])
  @@index([reportingYearId, companyId])
  @@index([companyId])
  @@index([emissionFactorId])
  @@map("activity_entries")
}

// A free-form row of "Datos sobre tecnologías más limpias y buenas prácticas" (CECODES,
// 2026-07-24): an OPEN section where the company reports cleaner-technology and good-practice
// initiatives "de una manera más libre". The rows NEVER feed the calculation engine; they only
// appear on the Resumen and in exports. That is why every descriptive field is free text
// (nothing is derived from the factor library, unlike ActivityEntry) and why quantity is
// nullable: a practice can be reported without a number.
model CleanTechEntry {
  id String @id @default(uuid())

  // Composite FK, exactly as ActivityEntry: companyId is bound to the reporting year, so a
  // spoofed companyId matches nothing.
  reportingYear   ReportingYear @relation(fields: [reportingYearId, companyId], references: [id, companyId], onDelete: Cascade)
  reportingYearId String
  companyId       String // denormalized for RLS

  scope       Scope? // optional Alcance the company associates the practice with
  category    String?
  subcategory String?
  element     String // what is being reported; the one required field
  quantity    Decimal? @db.Decimal(20, 6)
  unit        String?

  // Who wrote and last touched the row. Denormalized emails, like the audit tables, so the
  // attribution outlives the account.
  createdByEmail String?
  updatedByEmail String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reportingYearId])
  @@index([companyId])
  @@map("clean_tech_entries")
}

// Whether a company declares a whole category applicable for a reporting year. This is
// reportable data, not UI state: the GHG Protocol requires excluded categories to be
// disclosed with a justification, so "no aplica" has to survive to the report.
// Absence of a row means the category applies (the column default). The toggle exists to
// let a company hide sources it does not have, not to opt in.
model CategoryApplicability {
  id              String        @id @default(uuid())
  reportingYear   ReportingYear @relation(fields: [reportingYearId], references: [id], onDelete: Cascade)
  reportingYearId String
  companyId       String // denormalized for RLS
  scope           Scope
  category        String
  applies         Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([reportingYearId, scope, category])
  @@index([companyId])
  @@map("category_applicability")
}

// Reduction target per scope (Meta) - inclusion pending CECODES confirmation (Req. §12.9)
// One reduction goal per company: a single percentage of the company's TOTAL footprint (every
// facility, every Alcance combined), replacing an earlier per-Sede/per-Alcance tonnes design that
// the client's own decision memo (2026-07-28) never actually asked for. The baseline is always
// the company's first reported year, computed live as MIN(ReportingYear.year) - never snapshotted
// here, so if a company later deletes its original first year the baseline simply becomes
// whatever is now earliest, which is the same "first reported year" concept either way.
model CompanyTarget {
  id           String   @id @default(uuid())
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId    String   @unique
  reductionPct Decimal  @db.Decimal(5, 2) // e.g. 5.00 = "reduce total footprint by 5%"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("company_targets")
}

// ---------------------------------------------------------------------------
// Emission-factor library (admin-maintained, versioned) - Req. §8. Global reference data.
// ---------------------------------------------------------------------------

model EmissionFactorVersion {
  id           String           @id @default(uuid())
  version      String           @unique // e.g. "v005"
  date         DateTime
  preparedBy   String? // Elaboró
  reviewedBy   String? // Revisó
  authorizedBy String? // Autorizó
  description  String? // Descripción de cambios
  createdAt    DateTime         @default(now())
  factors      EmissionFactor[]

  @@map("emission_factor_versions")
}

model EmissionFactor {
  id          String  @id @default(uuid())
  scope       Scope
  category    String
  subcategory String?
  element     String
  unit        String // Unidad Consumo (activity unit)

  // Per-gas factors (modern per-gas model). Any may be null.
  co2Factor Decimal? @db.Decimal(30, 10) // kg CO2 / unit
  ch4Factor Decimal? @db.Decimal(30, 10) // kg CH4 / unit
  n2oFactor Decimal? @db.Decimal(30, 10) // kg N2O / unit

  // Consolidated factor for items already expressed in CO2e (refrigerants, SF6, spend/distance-based)
  co2eFactor    Decimal? @db.Decimal(30, 10) // kg CO2e / unit
  // Alternate consolidated factor per currency for spend-based Scope 3 (purchased goods & services)
  co2eFactorCop Decimal? @db.Decimal(30, 10) // kg CO2e / COP
  co2eFactorUsd Decimal? @db.Decimal(30, 10) // kg CO2e / USD
  // Which gas co2eFactor actually is, for a factor that arrives pre-blended (client feedback
  // 2026-08-15: "for the 'emisiones por gases' chart... specify those 'other' such SF6, NF3,
  // etc."). Free text, not an enum: the source workbook identifies only the COLUMN a value came
  // from (HFC/PFC/SF6/NF3), not a fixed small set of compounds, and a future workbook revision
  // may add columns for specific blends (HFC-134a, R-410A, ...) without a migration. Null for
  // every per-gas factor (co2Factor/ch4Factor/n2oFactor) and for a pre-blended factor whose
  // sheet column could not be identified (e.g. a spend/distance-based Scope 3 line read off
  // column 9 - see map-row.ts); the dashboard falls those back to a documented "unidentified"
  // bucket rather than guessing. Backfilled by prisma/import-factors.ts, never set by hand yet.
  gasType       String?

  factorUnit     String? // Unidad FE
  source         String? // Fuente bibliográfica
  gwpSet         GwpSet? // which GWP vintage the factor assumes, when relevant
  biogenic       Boolean  @default(false) // 0=No biogénica / 1=biogénica
  uncertaintyPct Decimal? @db.Decimal(10, 4)
  effectiveYear  Int? // for year-specific factors
  active         Boolean  @default(true)
  // Client feedback 2026-08-15: Scope 3 Cat 6 "Subsidios de transporte" is reported in COP, not
  // gallons; Cat 6/7 distance categories (unit "pasajeros * km" / "vehiculo * km") are reported
  // as a count and a distance, multiplied. Default QUANTITY changes nothing for any other factor.
  entryMode      EntryMode @default(QUANTITY)
  // Only meaningful when entryMode = MONEY_PER_GALLON: which of the yearly average prices the
  // reported money is divided by. Derived from the workbook row by src/lib/calc/fuel.ts on every
  // import, never typed by hand, so a renamed element cannot lose it.
  fuelType       FuelType?

  version   EmissionFactorVersion? @relation(fields: [versionId], references: [id])
  versionId String?

  entries   ActivityEntry[]
  changes   EmissionFactorChange[]
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  // The natural key (scope, category, subcategory, element, unit) is enforced by a hand
  // written expression index in the migration, because a plain unique index would treat two
  // NULL subcategories as distinct. It is not declared here: Prisma cannot express COALESCE.

  @@index([scope, category, subcategory])
  @@index([versionId])
  @@index([active])
  @@map("emission_factors")
}

// Per-factor audit trail. Requirements section 8: every change records who, when, and what.
//
// EmissionFactorVersion stays the library RELEASE concept (Excel "Control de Cambios"
// parity: v001..v005). This table is the per-edit record beneath it.
//
// `changes` holds a field diff, { field: { from, to } }, with every Decimal serialized as a
// string. Two full row snapshots per edit would triple the storage and force the UI to diff
// at read time; a CREATED row stores the whole initial state as from:null, so nothing is lost.
model EmissionFactorChange {
  id             String             @id @default(uuid())
  factor         EmissionFactor     @relation(fields: [factorId], references: [id], onDelete: Cascade)
  factorId       String
  changedBy      AppUser?           @relation(fields: [changedById], references: [id], onDelete: SetNull)
  changedById    String?
  changedByEmail String // denormalized: the audit row must outlive the actor
  action         FactorChangeAction
  changes        Json
  changedAt      DateTime           @default(now())

  @@index([factorId, changedAt])
  @@map("emission_factor_changes")
}

enum EntryChangeAction {
  SOURCE_ADDED // a source (element) was added to a reporting year
  VALUE_SET // an activity value was entered or changed
  VALUE_CLEARED // an activity value was emptied back to "not reported"
  COPIED // January was copied across the empty Scope-2 months
  SOURCE_REMOVED // a source and all its rows were deleted
}

// The audit trail for tenant data entry: who entered or changed which number, and when. This is
// CECODES's traceability requirement (2026-07-18): with several people per company, a wrong
// figure must point back to a person. It answers "who typed this, and what was it before".
//
// Deliberately NOT foreign-keyed to activity_entries. removeSource hard-deletes rows, and an FK
// would either cascade the audit away with them or block the delete; the log must OUTLIVE the
// rows it describes. It is instead keyed by the natural coordinates (reporting year, source,
// month) and carries a denormalized element label, so a change stays legible after its source is
// gone or its factor is renamed. The composite FK to reporting_years binds companyId to the year,
// exactly as activity_entries does, so a spoofed companyId matches nothing.
model ActivityEntryChange {
  id               String            @id @default(uuid())
  reportingYear    ReportingYear     @relation(fields: [reportingYearId, companyId], references: [id, companyId], onDelete: Cascade)
  reportingYearId  String
  companyId        String // denormalized for RLS and tenant-scoped reads
  emissionFactorId String? // which source; null-tolerant so a later factor delete cannot orphan the row
  scope            Scope
  element          String // denormalized, human-readable, survives a factor rename or removal
  month            Int? // 1..12 for a monthly cell, null for an annual value or a source-level event
  changedBy        AppUser?          @relation(fields: [changedById], references: [id], onDelete: SetNull)
  changedById      String?
  changedByEmail   String // denormalized: the audit row must outlive the actor
  action           EntryChangeAction
  changes          Json // { value: { from, to } } for value edits; {} for structural events
  changedAt        DateTime          @default(now())

  @@index([reportingYearId, changedAt])
  @@index([companyId, changedAt])
  @@index([reportingYearId, emissionFactorId, month])
  @@map("activity_entry_changes")
}

// Scope-2 national grid factor by year (SIN) - Req. §7.3. Global reference data.
model GridElectricityFactor {
  id             String   @id @default(uuid())
  year           Int      @unique
  factor         Decimal  @db.Decimal(30, 10) // kg CO2 / kWh
  source         String? // UPME / XM
  createdAt      DateTime @default(now())
  // Who last touched this year, and when. A full change table is unnecessary here: the year
  // rows are themselves the history, and the library version notes record the release.
  updatedAt      DateTime @default(now()) @updatedAt
  updatedByEmail String?

  @@map("grid_electricity_factors")
}

// Average price per gallon (COP) by year, for Scope 3 Cat 6 "Subsidios de transporte" - client
// feedback 2026-08-15. The company reports a money amount; the engine divides it by this year's
// price to get gallons, then prices the gallons with the normal per-gallon factor. Same shape and
// history convention as GridElectricityFactor: the year rows are themselves the history.
model TransportSubsidyPrice {
  id   String @id @default(uuid())
  year Int
  // One row per fuel per year - client feedback 2026-09-03 (E4). Before this there was a single
  // price per year and the diesel factor divided by the gasoline price.
  fuel FuelType
  // Decimal(20,6), not (20,2): CECODES's own averages carry twelve decimal places
  // (16046.315789473685 for 2024 gasoline, from "C6 - Viajes de negocios.xlsx"), and the old
  // scale made the admin form reject their number outright. Six decimals is far past materiality
  // for a COP price and matches the activity-value scale used everywhere else.
  pricePerGallonCop Decimal  @db.Decimal(20, 6) // COP / gal
  source            String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt
  updatedByEmail    String?

  @@unique([year, fuel])
  @@map("transport_subsidy_prices")
}

// One route of a transport source: a count and a distance, multiplied. Client feedback
// 2026-09-03 (E3): C4, C6, C7 and C9 need "a way to register pasajero*km and vehículo*km", and
// the four templates CECODES sent are one row per route, with a reference name and observations.
//
// A CHILD table rather than more ActivityEntry rows: activity_entries is uniquely keyed by
// (reportingYearId, emissionFactorId, month) plus a partial unique index for the annual rows, so
// N sibling rows per source are physically impossible there.
//
// The composite FK binds companyId to the entry, so a child row cannot claim one company while
// its entry belongs to another. That, plus src/lib/auth/company-scope.ts, is the isolation:
// RLS is inert through Prisma, which connects as the table owner.
model TransportTrip {
  id String @id @default(uuid())

  entry           ActivityEntry @relation(fields: [activityEntryId, companyId], references: [id, companyId], onDelete: Cascade)
  activityEntryId String
  companyId       String // denormalized for RLS

  // Display order, 0-based. saveTransportTrips rewrites the whole set, so positions stay dense.
  position Int
  // "Nombre de referencia - Fuente de emisión" in CECODES's templates: the route or trip name.
  reference String?
  // Passengers, vehicles or tonnes, per the first half of the factor's unit.
  count Decimal @db.Decimal(20, 6)
  // Distance in km, the second half of the unit.
  distanceKm Decimal @db.Decimal(20, 6)
  // "Observaciones".
  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([activityEntryId, position])
  @@index([activityEntryId])
  @@index([companyId])
  @@map("transport_trips")
}

// ---------------------------------------------------------------------------
// Computed results (pinned to the factor version used, for reproducibility) - Req. §8, §14
// ---------------------------------------------------------------------------

model ResultSnapshot {
  id              String        @id @default(uuid())
  reportingYear   ReportingYear @relation(fields: [reportingYearId], references: [id], onDelete: Cascade)
  reportingYearId String
  companyId       String // denormalized for RLS
  scope           Scope
  category        String?
  tonnesCo2e      Decimal       @db.Decimal(20, 6)
  biogenicTonnes  Decimal?      @db.Decimal(20, 6) // biogenic CO2 memo item (kept out of headline) - Req. §12.5
  factorVersionId String? // which factor library version produced this
  computedAt      DateTime      @default(now())

  @@index([reportingYearId])
  @@index([companyId])
  @@map("result_snapshots")
}
